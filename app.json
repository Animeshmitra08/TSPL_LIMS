{
  "expo": {
    "name": "TSPL_LIMS",
    "slug": "TSPL_LIMS",
    "version": "3.6.2",
    "orientation": "default",
    "icon": "./assets/images/LogoTspl.png",
    "scheme": "tspllims",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aondigicon.TSPLLIMS",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/LogoTspl.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aondigicon.TSPLLIMS",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Splash&Logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan sample QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44516200-8868-4a3b-bc8e-1f8fe2f24076"
      }
    }
  }
}
