# Quality api----------
# EXPO_PUBLIC_BASE_URL=https://tsplindia.info/TSPLSAMPLINGQA/api
# EXPO_PUBLIC_LOGIN_URL=https://tsplindia.info/itmsapi/api
EXPO_PUBLIC_API_TIMEOUT=30000

# Production api----------
EXPO_PUBLIC_BASE_URL=https://tsplindia.info/LIMSAPP/api
EXPO_PUBLIC_LOGIN_URL=https://tsplindia.info/TSPL_ITMS/api

# Authentication Storage Keys
EXPO_PUBLIC_AUTH_TOKEN_KEY=tspl_auth_token
EXPO_PUBLIC_AUTH_USER_KEY=tspl_auth_user

# Application Settings
EXPO_PUBLIC_APP_NAME=TSPL LIMS
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_DEBUG=true

# MQ live-feed WebSocket bridge — points at the production MQSERVER instance
# (TSPL-WB-Bridge NSSM service) on the plant network, reverse-proxied through
# IIS/ARR on tsplindia.info. Verified reachable and forwarding WS upgrades.
# NOTE: this is an EXPO_PUBLIC_ var, so it's inlined into the JS bundle at
# BUILD time — editing it here has no effect on an already-built APK. Any
# APK built before this line was uncommented still falls back to resolving
# the WS host from Metro's dev-server address, which doesn't exist in a
# standalone build and collapses to ws://localhost:8080. Rebuild after
# changing this value.
EXPO_PUBLIC_MQ_WS_URL=wss://tsplindia.info/wb-feed
#EXPO_PUBLIC_MQ_WS_URL=https://tsplindia.info/wb-feed

# Must match MQ_BRIDGE_TOKEN on the hosted bridge. This file is committed to
# git — DO NOT put the real token value here. It already lives in
# .env.local next to this file (gitignored via .env*.local), which Expo/
# dotenv loads with priority over this placeholder.
# EXPO_PUBLIC_MQ_WS_TOKEN=changeme

# As of Expo SDK 56, expo-router's dev server refuses to bundle at all if
# @react-navigation/drawer is imported anywhere in the app (it wants
# expo-router/drawer instead) — this app's DrawerNavigator
# (app/(drawer)/DrawerNavigator.tsx) still uses the former, rendered as a
# plain nested component inside app/(tabs)/_layout.tsx rather than as an
# expo-router layout file, so it still works fine at runtime; this just
# disables the check so Metro will actually serve a bundle. Remove this once
# DrawerNavigator is migrated to expo-router/drawer.
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
